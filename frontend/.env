# current = ikut protokol dari frontend
# jika ingin menggunakan protokol lain seperti https, masukkan protokol
# https:, intinya semua protokol diakhiri dengan simbol ":" (http:, ftp:,dst)
VITE_BACKEND_PROTOCOL=current

# current = ikut hostname/alamat IP dari frontend
# jika backend memiliki hostname/alamat IP yang berbeda dari frontend,
# masukkan hostname/alapat IP yang ingin dituju tanpa port 
# (contoh server-1.local, 192.168.0.2, dst)
VITE_BACKEND_HOSTNAME=current

# current = ikut port dari frontend
# default = ikut port default dari protokol yang digunakan
# jika port berbeda dari frontend dan tidak menggunakan port default protokol,
# masukkan port dari backend dalam variabel ini (contoh: 8000, 8080, 7878, dst)
VITE_BACKEND_PORT=current
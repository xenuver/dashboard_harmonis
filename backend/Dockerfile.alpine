FROM php:8.3-fpm-alpine AS php-extension-builder

COPY --from=mlocati/php-extension-installer:2 \
    /usr/bin/install-php-extensions /usr/local/bin/

RUN IPE_SAVE_PERMDEPS_TO=/tmp/php-runtime-deps.txt \
    install-php-extensions \
        gd pdo_mysql zip # curl mbstring pdo_sqlite sqlite3 xml opcache


FROM php-extension-builder AS composer-builder
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
RUN apk add --no-cache git unzip
WORKDIR /var/www/html

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-scripts \
        --no-autoloader --prefer-dist \
    && composer clear-cache

COPY . .
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev


FROM php:8.3-fpm-alpine AS app

COPY --from=php-extension-builder /tmp/php-runtime-deps.txt /tmp/
RUN set -eux; \
    packages="$(tr '\n' ' ' < /tmp/php-runtime-deps.txt | xargs)"; \
    [ -z "$packages" ] || apk add --no-cache $packages; \
    rm -f /tmp/php-runtime-deps.txt; \
    mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

COPY --from=php-extension-builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=php-extension-builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

WORKDIR /var/www/html

COPY --chown=www-data:www-data . .
COPY --from=composer-builder --chown=www-data:www-data /var/www/html/vendor ./vendor

RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/framework/cache/data \
    storage/logs \
    bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

EXPOSE 9000
CMD ["php-fpm"]